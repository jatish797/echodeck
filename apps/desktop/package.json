{
  "name": "@echodeck/desktop",
  "version": "0.1.0",
  "description": "EchoDeck Desktop Application (Electron + React)",
  "main": "electron/dist/main.js",
  "author": "Your Name",
  "license": "ISC",
  "scripts": {
    "dev:electron": "tsx watch electron/main.ts",
    "dev:vite": "vite",
    "dev": "concurrently \"npm:dev:vite\" \"npm:dev:electron\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:vite": "tsc && vite build",
    "build": "npm run build:vite && npm run build:electron",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "concurrently": "^8.2.2"
  }
}
